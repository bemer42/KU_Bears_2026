%Crypt Fission 2

clear; close all; clc

% Discretize space:
N_u = 1e2;
u = linspace(0, 2*pi, N_u);


N_v = 3e2;
v = linspace(0,78,N_v)';


%Create mesh grid:
[U_mesh,V_mesh] = meshgrid(u,v);

% Define radius function:
L = 78;
r_b = 41/2/pi;
r_t = 10/pi;   
a = 0.3;   
b = 0.15;
w = 5;



R_v = r_b*(1 - exp(-a * V_mesh)) + r_t * exp(a * (V_mesh - L));



for c = -10 : 90

    alpha = 0.5 * (1+ tanh((c - V_mesh)/w));

    beta_val = 1 + b * exp(-(c - V_mesh).^2 / w^2);

    bR = beta_val .* R_v;

    rn0_x = bR .* cos(U_mesh);
    rn0_y = bR .* sin(U_mesh);

    rn1_x = 2 * bR .* sin(U_mesh) .* cos(U_mesh);
    rn1_y = 2 * bR .* sin(U_mesh) .* sin(U_mesh);

    Dn

   


    % Generate surface plot
    figure(1)
    surf(X1, Y2, Z, lambda)
    hold on

    surf(X2, Y2, Z, lambda)
    hold off

    shading interp
    grid on
    grid minor
    colormap winter
    axis equal
    xlim([-45 45])
    ylim([-45 45])
    zlim([-2 80])
    if c == -30
        pause(1)
    else
        drawnow
    end


end