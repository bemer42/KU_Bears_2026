%% Spatial ODE with space varying Wnt Signal
close; clear all; clc

% Discretize time: 
N_t   = 1e5;
t_0   = 0;
t_end = 5e6;
t     = linspace(t_0,t_end,N_t);

% Discretize space: 
N_z   = 83; 
z_0   = 0; 
z_end = 82; 
z     = linspace(z_0,z_end,N_z);

% Define a Wnt signal: 
W = @(z) exp(-z/10);

% Define initial condition: 
U0 = [90; 200; 1e-3];

% Solve for APC, Beta-Cat, and Axin for every z value: 
for i = 1:N_z
    
    [t,U] = ABX_fun(t,U0,W(z(i)));

    A(:,i) = U(:,1);  
    B(:,i) = U(:,2); 
    X(:,i) = U(:,3);

end






