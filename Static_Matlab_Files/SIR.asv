%% Lotka_Volterra

close all; clear; clc

% Discretize time: 
N = 1e4;
t_0 = 0;
t_end = 100;
t = linspace(t_0,t_end,N);

% Initial condition
S0 = .99;
I0 = .01;
R0 = 0;

U0 = [S0; I0; R0];

% Parameters
alpha = .1;
beta  = 1.4;
gamma = .4;
mu    = .1;


% Right hand side:
dUdt = @(t, U)[alpha - beta*U(1).*U(2) - mu*U(1);
               beta*U(1).*U(2) - gamma*U(2) - mu*U(2);
               gamma*U(2) - mu*U(3)];

% Numerically solve the IVP
[t,U] = ode45(dUdt, t, U0);

S = U(:,1);
I = U(:,2);
R = U(:,3);

%Plot
figure(1);
plot(t, S, 'LineWidth', 1.5); hold on;
plot(t, I, 'LineWidth', 1.5);
plot(t, R, 'LineWidth', 1.5);
title('Classic SIR');
xlabel('Time (t)');
ylabel('Population');
legend('S', 'I', 'R');
grid on;
grid minor;
    


%Phase Plane
N_mesh = 8;
vec = linspace(0,1,N_mesh);

[Sm,Im,Rm] = meshgrid(vec,vec,vec);

Fs = @(S,I,R) alpha - beta*S.*I - mu*S;
Fi = @(S,I,R) beta*S.*I - gamma*I - mu*I;
Fr = @(S,I,R) gamma*I - mu*R;

figure(2)
quiver3(Sm,Im,Rm,Fs(Sm,Im,Rm),Fi(Sm,Im,Rm),Fr());
hold on;
plot(u, v, 'k-', 'LineWidth', 2); hold on;
plot(u0,v0, 'go','LineWidth', 4)
plot(u(end),v(end), 'ro', 'LineWidth',3)
xlabel('u');
ylabel('v');
grid on;
grid minor;
